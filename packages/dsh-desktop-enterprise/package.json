{
  "name": "dsh-desktop-enterprise",
  "version": "0.2.0",
  "description": "Built-in BiSheng enterprise identity and model integration for DSH Desktop.",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./client.js",
    "./contract": "./contract.js",
    "./deep-link": {
      "types": "./deep-link.d.ts",
      "default": "./deep-link.js"
    },
    "./openai": "./openai.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-connection": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/cordis-plugin-group": "~1.0.4",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.5",
    "@deepseek-ai/dsh-app-boot": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2",
    "dsh-desktop-market-installer": "0.1.0",
    "pnpm": "10.34.5",
    "@deepseek-ai/dsh-plugin-manager": "^0.2.1-rc.2"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@modelcontextprotocol/client": "2.0.0",
    "semver": "7.8.5",
    "tar": "7.5.22"
  }
}
